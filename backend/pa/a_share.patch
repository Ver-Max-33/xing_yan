+def widen_stop_for_t_plus_1(decision: dict[str, Any], *, kline_frame: Any = None) -> bool:
+    """[形研 A股] T+1: a share bought today cannot be sold today, so a long's stop closer to the entry than K1's ATR14 (a
+    day's normal move) is often crossed on the very day the buy fills — 19% of fills at 0.75 ATR, 10% at one ATR (all
+    A-shares 2024–2026) — and sold only at the next open. Such a stop goes out to one ATR under the entry, on the tick."""
+    if decision.get("order_type") not in ("限价单", "突破单", "市价单") or not is_long_direction(decision.get("order_direction")):
+        return False
+    try:
+        entry, sl = float(decision["entry_price"]), float(decision["stop_loss_price"])
+    except (TypeError, ValueError, KeyError):
+        return False
+    from pa_agent.ai.market_features import _current_atr   # PA's own: K1's ATR14, as the K-line table shows it
+    from pa_agent.util.price_tick import infer_price_tick_from_frame
+
+    atr = _current_atr(kline_frame) if kline_frame is not None else None
+    if not atr or sl >= entry or entry - sl >= atr - 1e-9:   # a stop not under the entry is for the checks to refuse
+        return False
+    tick = infer_price_tick_from_frame(kline_frame) or 0.0
+    new_sl = round(math.floor((entry - atr) / tick + 1e-9) * tick, 10) if tick else entry - atr
+    decision.setdefault("ai_stop_loss_price", sl)
+    decision["stop_loss_price"] = new_sl
+    return True
+
