+def judge_range_position(frame: Any) -> NodeFill | None:
+    """[形研 A股] §6.3 from where PA's own features put K1's close in its range, in thirds
+    (market_features.compute_simple_market_features): the AI read that very number and judged §6.3 itself, differently
+    from run to run on the same bars (10-21)."""
+    from pa_agent.ai.market_features import compute_simple_market_features
+
+    f = compute_simple_market_features(frame)
+    where = {"lower_third": ("是", "lower", "下三分之一：下边界"), "middle_third": ("否", "middle", "中间三分之一：区间中部"),
+             "upper_third": ("是", "upper", "上三分之一：上边界")}.get(f.zone)
+    if f.price_position is None or where is None:
+        return None
+    return NodeFill(node_id="6.3", answer=where[0], branch=where[1], bar_range=f"K{f.lookback_bars}-K1",
+                    reason=f"收盘位置分位 {f.price_position:.2f}（近{f.lookback_bars}棒包络 {f.range_low}–{f.range_high}），"
+                           f"在{where[2]}（程序按三等分算）。")
+
+
+def judge_entry_position(frame: Any, decision: dict[str, Any]) -> str | None:
+    """[形研 A股] Where the buy price sits in the range PA measures the close in (compute_simple_market_features, its
+    thirds): the middle third, said plainly, or None. PA's rules put no order there — 「中间位置不挂单」 (§11.3), 「在区间中部
+    入场」 (§14), §9.0P 否 「区间/通道中部」 — but its program measured only the close (10-21)."""
+    from pa_agent.ai.market_features import _zone_from_position, compute_simple_market_features
+
+    f = compute_simple_market_features(frame)
+    try:
+        entry = float(decision["entry_price"])
+    except (TypeError, ValueError, KeyError):
+        return None
+    if f.range_low is None or f.range_high is None or f.range_high <= f.range_low:
+        return None
+    pos = round((entry - f.range_low) / (f.range_high - f.range_low), 3)
+    if _zone_from_position(pos) != "middle_third":
+        return None
+    return (f"买入价在区间中部，不挂单：{_middle_words(f)}，买入价 {entry:.2f} 落在中间那一段（{_middle_band(f)}）。"
+            "区间中间涨跌的机会差不多，PA 在区间里只在靠近底部的地方买。")
+
+
+def _middle_words(f: Any) -> str:
+    return f"近 {f.lookback_bars} 根 K 线在 {f.range_low:.2f}–{f.range_high:.2f} 之间"
+
+
+def _middle_band(f: Any) -> str:
+    w = f.range_high - f.range_low
+    return f"{f.range_low + w / 3:.2f}–{f.range_low + 2 * w / 3:.2f}"
+
